# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.
#
# Only the Supabase URL and the anon/publishable key belong here.
# NEVER put the service role key or database password in a client-side env
# var (see CLAUDE.md §9 and the `frontend-security` skill) — anything
# prefixed VITE_ is bundled into the browser build and is public.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
